# === CẤU HÌNH IP LAN (Thay đổi theo thực tế máy của bạn) ===
NODE_A_IP=192.168.1.81
NODE_B_IP=192.168.1.82
NODE_C_IP=192.168.1.83

# Mật khẩu các dịch vụ Infrastructure
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
RABBITMQ_USER=user
RABBITMQ_PASS=password

# JWT
JWT_SECRET=supersecret

# === URLs Dịch vụ (Luôn trỏ về Node A cho Database & RabbitMQ) ===
DATABASE_URL_USER=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${NODE_A_IP}:5432/userdb?schema=public
DATABASE_URL_MOVIE=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${NODE_A_IP}:5432/moviedb?schema=public
DATABASE_URL_BOOKING=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${NODE_A_IP}:5432/bookingdb?schema=public

AMQP_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${NODE_A_IP}:5672

# URLs cho API Gateway (Trỏ về máy tương ứng)
USER_SERVICE_URL=http://${NODE_A_IP}:8001
MOVIE_SERVICE_URL=http://${NODE_B_IP}:8002
BOOKING_SERVICE_URL=http://${NODE_B_IP}:8003
PAYMENT_SERVICE_URL=http://${NODE_C_IP}:8004
