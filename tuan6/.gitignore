# Root .gitignore for tuan6 (Node.js & Java)

# --- Dependencies ---
**/node_modules/
**/jspm_packages/

# --- Build Artifacts ---
**/target/
**/dist/
**/build/
**/out/
.gradle/
.pnpm-store/

# --- Logs ---
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Files ---
# The user explicitly requested to ALLOW .env files
!.env
!.env.*
# If you want to ignore template files but keep .env, uncomment below:
# .env.example
# .env.template

# --- IDEs and Editors ---
.idea/
.vscode/
*.swp
*.swo
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Docker ---
# Optional: keep docker logs ignored if they are outside normal log patterns
# docker-compose.override.yml (uncomment if you want to keep local overrides untracked)

# --- Java/Maven Specific ---
.mvn/wrapper/maven-wrapper.jar
# (Keep mvnw and mvnw.cmd as they are usually committed)
