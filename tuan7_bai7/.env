# ============================================================
# 1. CẤU HÌNH MẠNG LAN (MÁY CHỦ CHẠY DOCKER)
# ============================================================
# Địa chỉ IP LAN của máy đang chạy Docker.
# Dùng để Frontend (trình duyệt) có thể kết nối tới Backend.
LAN_IP=192.168.90.67

# ============================================================
# 2. CẤU HÌNH KẾT NỐI INFRASTRUCTURE (CHO MICROSERVICES)
# ============================================================
# Nếu chạy tất cả trên 1 máy (Single Machine): 
#   - Dùng tên service: postgres, redis, rabbitmq
# Nếu chạy trên nhiều máy (Distributed):
#   - Thay bằng IP máy tương ứng (ví dụ: 192.168.1.10)

DB_HOST=postgres
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq

# Connection Strings (Tự động tạo dựa trên HOST ở trên)
DATABASE_URL=postgresql://admin:adminpassword@${DB_HOST}:5432/flashsale_db?schema=public
REDIS_URL=redis://${REDIS_HOST}:6379
RABBITMQ_URL=amqp://admin:adminpassword@${RABBITMQ_HOST}:5672

# ============================================================
# 3. CẤU HÌNH ENDPOINTS CHO FRONTEND (VITE)
# ============================================================
# Các URL này được nhúng vào Frontend lúc build.
# Mặc định trỏ về máy chạy các Microservices (thường là LAN_IP).
VITE_PRODUCT_SERVICE_URL=http://${LAN_IP}:8081
VITE_CART_SERVICE_URL=http://${LAN_IP}:8082
VITE_ORDER_SERVICE_URL=http://${LAN_IP}:8083
VITE_INVENTORY_SERVICE_URL=http://${LAN_IP}:8084

# ============================================================
# 4. CẤU HÌNH NỘI BỘ GIỮA CÁC SERVICE
# ============================================================
# Dùng khi các service gọi nhau. Nếu tách máy, thay bằng IP máy App.
INVENTORY_SERVICE_INTERNAL_URL=http://inventory-service:8084
